# Clave secreta propia: elegí cualquier string largo y random.
# Es la que vas a usar tanto desde la app (index.html) como desde Gemini.
API_KEY=cambiar-por-una-clave-larga-y-secreta

# Estas dos las completa Vercel automáticamente al agregar la integración
# de Redis (Marketplace > Storage > Upstash / Redis). No hace falta que
# las cargues a mano salvo que estés corriendo el proyecto en tu PC.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
